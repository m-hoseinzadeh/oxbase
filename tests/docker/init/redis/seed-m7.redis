# M7 fixture keys (docs/m7-contracts.md §9.2; names in tests/fixtures.toml [m7.redis]).
# Piped to redis-cli by entrypoint.sh after seed.redis, when the marker key
# oxbase_test:fixture:m7_seeded is absent (entrypoint.sh sets it after a clean run). Starts by
# deleting every key it creates, so a reseed cannot duplicate list entries or stream IDs.
# Not here (entrypoint.sh does them): m7:json (JSON.SET, only when RedisJSON is loaded) and the
# ACL user m7_reader (ACL rules are not persisted in the AOF, so it is set on every start).
# m7:ttl is set here and again by entrypoint.sh on every start (it expires after 24 h, the
# marker does not).
# Arguments use redis-cli quoting: "\x00\xff\xfe\n" is the four bytes 00 ff fe 0a.
SELECT 0
DEL m7:string m7:binary m7:hash m7:list m7:set m7:zset m7:stream m7:ttl m7:json m7:big:list m7:big:zset m7:ns:a:1 m7:ns:a:2 m7:ns:b:1 m7:ns:leaf m7:edit:seed
SET m7:string hello
SET m7:binary "\x00\xff\xfe\n"
HSET m7:hash f1 v1 f2 v2 f3 "grüße"
RPUSH m7:list a b c
SADD m7:set a b c
ZADD m7:zset 1 a 2 b 3 c
XADD m7:stream 1767261600000-0 k v1
XADD m7:stream 1767261600000-1 k v2
SET m7:ttl expires EX 86400
# 200 000 elements "e1" .. "e200000" and members "m1" .. "m200000" (score n), 1000 per command.
EVAL "local n = tonumber(ARGV[1]) for i = 1, n, 1000 do local t = {} for j = i, math.min(i + 999, n) do t[#t + 1] = 'e' .. j end redis.call('RPUSH', KEYS[1], unpack(t)) end return redis.call('LLEN', KEYS[1])" 1 m7:big:list 200000
EVAL "local n = tonumber(ARGV[1]) for i = 1, n, 1000 do local t = {} for j = i, math.min(i + 999, n) do t[#t + 1] = j t[#t + 1] = 'm' .. j end redis.call('ZADD', KEYS[1], unpack(t)) end return redis.call('ZCARD', KEYS[1])" 1 m7:big:zset 200000
# The namespace tree m7: -> m7:ns: -> {m7:ns:a: (2 keys), m7:ns:b: (1 key), m7:ns:leaf}.
SET m7:ns:a:1 a1
SET m7:ns:a:2 a2
SET m7:ns:b:1 b1
SET m7:ns:leaf leaf
HSET m7:edit:seed v 1
SELECT 1
DEL m7:db1:key
SET m7:db1:key one
SELECT 0
