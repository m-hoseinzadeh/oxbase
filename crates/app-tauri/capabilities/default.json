{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window. Grants exactly the app commands the UI calls (each declared in build.rs) and the dialog plugin's file-open picker (SQLite database, TLS certificate and key, SSH key files). Import and export files are picked by native dialogs shown from Rust (file_pick_open / file_pick_save return opaque handles), so they need no dialog, fs or shell permission here. No other core or plugin permission is granted.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-demo-arrow-page",
    "allow-list-profiles",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-test-connection",
    "allow-open-connection",
    "allow-cancel-request",
    "allow-close-connection",
    "allow-list-open-connections",
    "allow-tree-children",
    "allow-object-load",
    "allow-query-run",
    "allow-query-page",
    "allow-query-cancel",
    "allow-query-close",
    "allow-query-close-editor",
    "allow-statement-at",
    "allow-history-list",
    "allow-history-delete",
    "allow-history-clear",
    "allow-history-get-settings",
    "allow-history-set-settings",
    "allow-table-data-open",
    "allow-edit-begin",
    "allow-edit-apply",
    "allow-row-get-form",
    "allow-designer-load",
    "allow-designer-preview",
    "allow-designer-apply",
    "allow-capabilities-get",
    "allow-file-pick-open",
    "allow-file-pick-save",
    "allow-file-release",
    "allow-import-preview",
    "allow-import-plan",
    "allow-import-run",
    "allow-import-cancel",
    "allow-export-run",
    "allow-export-cancel",
    "dialog:allow-open"
  ]
}
