<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installers" (docs/code-signing.md). Paste it into the SignPath
  project as an artifact configuration with the slug `installers`.

  The input is the zip that .github/workflows/bundle.yml uploads: the Windows .msi and the NSIS
  -setup.exe of one build. The .msi is deep-signed (the app .exe inside it, then the .msi); the
  NSIS installer is signed as a whole (SignPath cannot open NSIS archives). Product name and
  version are enforced on every signed file, as SignPath Foundation requires; `version` comes
  from the workflow (scripts/release-check.mjs, the version in Cargo.toml).

  The app is installed as `app-tauri.exe` (the MSI's File table; the Cargo binary name). Check with
  a test-signing run first (docs/code-signing.md, step 5): the path of that .exe inside the .msi
  and the version format Tauri writes into its metadata are confirmed there.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <msi-file path="Oxbase_${version}_x64_en-US.msi">
      <pe-file path="**/app-tauri.exe" product-name="Oxbase" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
    <pe-file path="Oxbase_${version}_x64-setup.exe" product-name="Oxbase" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
